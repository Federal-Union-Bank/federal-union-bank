# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local example:  postgresql://postgres:password@localhost:5432/federal_union
# Neon/Supabase:  postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/federal_union

# ── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate a strong random secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# The public URL of your app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ── Price feed (optional) ─────────────────────────────────────────────────────
# CoinGecko free API key — sign up at https://www.coingecko.com/en/api
# Leave blank to use the free public endpoint (rate-limited to ~30 req/min)
COINGECKO_API_KEY=

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
